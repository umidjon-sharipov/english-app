generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id                String            @id @default(uuid()) @db.Uuid
    firstName         String            @db.VarChar(100)
    lastName          String?           @db.VarChar(100)
    userName          String            @unique @db.VarChar(100)
    passwordHash      String            @db.VarChar(255)
    email             String?           @db.VarChar(255)
    phone             String?           @db.VarChar(20)
    image             String?           @db.Text
    bio               String?           @db.Text
    avatarUrl         String?
    createdAt         DateTime          @default(now()) @db.Timestamptz(6)
    updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
    createdTests      Test[]            @relation("CreatedTests")
    participatedTests TestParticipant[] @relation("ParticipatedTests")

    @@map("Users")
  createdReadingSets      ReadingSet[]         @relation("CreatedReadingSets")
  participatedReadingSets ReadingParticipant[] @relation("ParticipatedReadingSets")
}

enum TestStatus {
    OPEN
    CLOSED
}

model Test {
    id              String            @id @default(cuid())
    title           String
    topic           String
    level           String
    questionCount   Int
    status          TestStatus        @default(OPEN)
    maxParticipants Int?
  startsAt        DateTime?
  endsAt          DateTime?
  designTheme     String            @default("minimal")
    questionsJson   Json
    creatorId       String            @db.Uuid
    creator         User              @relation("CreatedTests", fields: [creatorId], references: [id], onDelete: Cascade)
    participants    TestParticipant[]
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    @@index([creatorId])
    @@index([status])
  allowParticipantAi Boolean    @default(false)
  blockedUserIds     String[]   @default([])
}

model TestParticipant {
    id          String    @id @default(cuid())
    testId      String
    test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
    userId      String    @db.Uuid
    user        User      @relation("ParticipatedTests", fields: [userId], references: [id], onDelete: Cascade)
    score       Int?
    total       Int?
    completedAt DateTime?
    joinedAt    DateTime  @default(now())

    @@unique([testId, userId])
    @@index([testId])
    @@index([userId])
}
model ReadingSet {
  id                 String               @id @default(cuid())
  title              String
  topic              String
  level              String               @default("B1")
  length             String               @default("medium")
  passageCount       Int                  @default(1)
  questionsPerPassage Int                 @default(5)
  status             TestStatus           @default(OPEN)
  allowParticipantAi Boolean              @default(false)
  blockedUserIds     String[]             @default([])
  passagesJson       Json
  creatorId          String               @db.Uuid
  creator            User                 @relation("CreatedReadingSets", fields: [creatorId], references: [id], onDelete: Cascade)
  participants       ReadingParticipant[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([creatorId])
  @@index([status])
  questionType       String               @default("test")
}

model ReadingParticipant {
  id          String    @id @default(cuid())
  readingId   String
  reading     ReadingSet @relation(fields: [readingId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation("ParticipatedReadingSets", fields: [userId], references: [id], onDelete: Cascade)
  score       Int?
  total       Int?
  feedbackJson Json?
  completedAt DateTime?
  joinedAt    DateTime  @default(now())

  @@unique([readingId, userId])
  @@index([readingId])
  @@index([userId])
}
