generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id                String            @id @default(uuid()) @db.Uuid
    firstName         String            @db.VarChar(100)
    lastName          String?           @db.VarChar(100)
    userName          String            @unique @db.VarChar(100)
    passwordHash      String            @db.VarChar(255)
    email             String?           @db.VarChar(255)
    phone             String?           @db.VarChar(20)
    image             String?           @db.Text
    bio               String?           @db.Text
    avatarUrl         String?
    createdAt         DateTime          @default(now()) @db.Timestamptz(6)
    updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
    createdTests      Test[]            @relation("CreatedTests")
    participatedTests TestParticipant[] @relation("ParticipatedTests")

    @@map("Users")
}

enum TestStatus {
    OPEN
    CLOSED
}

model Test {
    id              String            @id @default(cuid())
    title           String
    topic           String
    level           String
    questionCount   Int
    status          TestStatus        @default(OPEN)
    maxParticipants Int?
  startsAt        DateTime?
  endsAt          DateTime?
  designTheme     String            @default("minimal")
    questionsJson   Json
    creatorId       String            @db.Uuid
    creator         User              @relation("CreatedTests", fields: [creatorId], references: [id], onDelete: Cascade)
    participants    TestParticipant[]
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    @@index([creatorId])
    @@index([status])
}

model TestParticipant {
    id          String    @id @default(cuid())
    testId      String
    test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
    userId      String    @db.Uuid
    user        User      @relation("ParticipatedTests", fields: [userId], references: [id], onDelete: Cascade)
    score       Int?
    total       Int?
    completedAt DateTime?
    joinedAt    DateTime  @default(now())

    @@unique([testId, userId])
    @@index([testId])
    @@index([userId])
}
